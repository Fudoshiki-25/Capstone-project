# ── Railway deployment notes ──────────────────────────────────────────────
# Set these as environment variables in the Railway dashboard, NOT in a
# committed .env file. Generate APP_KEY locally with `php artisan key:generate
# --show` and paste the result in — the container does not generate one for
# you (regenerating it on every deploy would invalidate every session/cookie).
#
# DB_* — Railway's MySQL plugin exposes MYSQLHOST/MYSQLPORT/MYSQLDATABASE/
# MYSQLUSER/MYSQLPASSWORD; either reference those directly as DB_HOST etc.
# via Railway's variable-reference UI, or set DB_* to the same values.
#
# Uploaded files (profile photos, proof of payment, requirement documents)
# are written to storage/app/public. Attach a Railway Volume mounted at
# /var/www/html/storage/app/public or every redeploy wipes them.
APP_NAME="Premiere Heights Learning Center, Inc."
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app.up.railway.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# stderr, not a log file — Railway captures container stdout/stderr as logs,
# and the local filesystem is ephemeral so a log file would vanish on redeploy.
LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Requires TrustProxies (already configured in bootstrap/app.php) to detect
# HTTPS correctly behind Railway's reverse proxy — without that this causes
# a redirect loop instead of just failing to set the cookie.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Sending from onboarding@resend.dev only delivers to Resend's own account-
# owner test address — verify your own domain in Resend before real parents
# rely on password-reset/notification emails.
MAIL_MAILER=resend
MAIL_FROM_ADDRESS="onboarding@resend.dev"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=

RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

VITE_APP_NAME="${APP_NAME}"
